# Copy this file to .env and edit. Restart Waypoints after changes.

# How the teacher reaches Claude:
#   claude_code = your Claude subscription, through Claude Code (must be installed and logged in)
#   api         = an Anthropic API key, pay per use (set ANTHROPIC_API_KEY below)
TEACHER=claude_code

# Only for TEACHER=api. Create one at https://console.anthropic.com and set a spending limit there.
ANTHROPIC_API_KEY=

# Claude Code route: model alias and effort per task type.
# "complex" is only used to draw up the plan; it falls back to CC_FALLBACK_MODEL if unavailable.
CC_MODEL_QUICK=sonnet
CC_EFFORT_QUICK=low
CC_MODEL_DEFAULT=sonnet
CC_EFFORT_DEFAULT=high
CC_MODEL_COMPLEX=opus
CC_EFFORT_COMPLEX=high
CC_FALLBACK_MODEL=sonnet

# API route: model per task type.
API_MODEL_QUICK=claude-sonnet-5
API_MODEL_DEFAULT=claude-sonnet-5
API_MODEL_COMPLEX=claude-opus-5

# Seconds before a Run is stopped.
RUN_TIMEOUT=10
